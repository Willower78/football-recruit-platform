# ---------------------------------------------------------------------------
# Football Recruit Platform — example environment variables
# Copy to `.env` and fill in values. Docker Compose reads `.env` automatically.
# ---------------------------------------------------------------------------

# ----- Postgres (with PostGIS) --------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=frp
POSTGRES_PASSWORD=frp_password
POSTGRES_DB=football_recruit

# Full connection URL (used by backend / migration scripts)
DATABASE_URL=postgres://frp:frp_password@postgres:5432/football_recruit

# ----- Redis ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ----- MinIO (S3-compatible object storage) -------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=frp-media
MINIO_REGION=us-east-1

# ----- Backend (NestJS) ---------------------------------------------------
NODE_ENV=development
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Bcrypt rounds
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:3000

# ----- Frontend (Next.js) -------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Football Recruit Platform

# ----- Default admin user (seeded on first migration run) -----------------
ADMIN_EMAIL=admin@footballrecruit.com
ADMIN_PASSWORD=ChangeMe123!
